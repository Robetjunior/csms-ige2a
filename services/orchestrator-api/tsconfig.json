{
  "compilerOptions": {
    "types": ["node"],
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",                // <— era "src"
    "outDir": "dist",
    "esModuleInterop": true,
    "strict": true,
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@src/*": ["src/*"],
      "@supabase": ["supabase.ts"]
    }
  },
  "include": ["src/**/*.ts", "supabase.ts"],  
  "exclude": ["node_modules", "dist"]
}
