# ====== DATABASE (Supabase - pooler) ======
POSTGRES_URI=postgresql://<user>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/<db>?sslmode=require
SUPABASE_DB_URL=\

# ====== SUPABASE (HTTP SDK) ======
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=<anon_key>
# Opcional: use SERVICE_KEY em ambientes server-side
SUPABASE_SERVICE_KEY=<service_role_key>

# ====== APP ======
JWT_SECRET=dev-secret
PAYMENT_WEBHOOK_SECRET=dev-pay
BATCH_SIZE=200
POLL_INTERVAL_MS=5000
ORCH_API_KEY=minha_chave_super_secreta

# ====== OCPP ======
OCPP_ENGINE_KIND=mock
OCPP_ENGINE_URL=

# ====== Docs/Dev ======
ENABLE_DOCS=1
DASHBOARD_ORIGINS=http://localhost:5173
OCPP_CALL_TIMEOUT_MS=15000
OCPP_PING_MS=30000

# ====== Pool ======
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=10000
