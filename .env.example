# ====== Ambiente ======
NODE_ENV=development

# ====== Supabase (primário) ======
# Cole os valores ROTACIONADOS do dashboard
SUPABASE_URL=<<COLE_AQUI>>
SUPABASE_ANON_KEY=<<COLE_AQUI>>
SUPABASE_SERVICE_KEY=<<COLE_AQUI>>

# Use o POOLER do Supabase (pgBouncer) + SSL obrigatório.
# Porta do pooler costuma ser 6543 (mais estável pra apps Node).
# Formato: postgresql://postgres.<PROJECTREF>:<PASSWORD>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_URL=postgresql://postgres.<PROJECTREF>:<PASSWORD>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# O app lê POSTGRES_URI OU SUPABASE_DB_URL. Como dotenv não expande, define os dois:
POSTGRES_URI=postgresql://postgres.<PROJECTREF>:<PASSWORD>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Pool/tempo de conexão
PG_POOL_MAX=10
PG_CONNECT_TIMEOUT_MS=10000
PG_IDLE_TIMEOUT_MS=30000
# Se algum DNS/IPv6 atrapalhar, ligue:
# PG_FORCE_IPV4=1
# Para SSL estrito no pool do 'pg' (você já trata no código, mas fica aqui também):
PG_SSL_ENABLED=1
PG_SSL_REJECT_UNAUTHORIZED=0

# ====== APP ======
JWT_SECRET=dev-secret
PAYMENT_WEBHOOK_SECRET=dev-pay
BATCH_SIZE=200
POLL_INTERVAL_MS=5000
ENABLE_DOCS=1
DASHBOARD_ORIGINS=http://localhost:5173
OCPP_CALL_TIMEOUT_MS=15000
OCPP_PING_MS=30000
ORCH_API_KEY=minha_chave_super_secreta

# ====== OCPP ENGINE ======
OCPP_ENGINE_KIND=mock
OCPP_ENGINE_URL=
